rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'jenasanjay17@gmail.com'
      );
    }

    // Validation Blueprint: UserPreference (/users/{userId})
    function isValidUserPreference(data, targetUserId) {
      return data.keys().hasAll(['userId', 'displayName', 'theme', 'preferredLanguage', 'preferredModel', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'theme', 'preferredLanguage', 'preferredModel', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.userId == targetUserId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.theme is string && data.theme.size() <= 16 && (data.theme == 'dark' || data.theme == 'light') &&
        data.preferredLanguage is string && data.preferredLanguage.size() <= 8 && (data.preferredLanguage == 'en' || data.preferredLanguage == 'ta') &&
        data.preferredModel is string && data.preferredModel.size() <= 40 &&
        (data.preferredModel == 'gemini-4-hydrogen' || data.preferredModel == 'gemini-3.1-flash-lite' || data.preferredModel == 'gemini-4-argon' || data.preferredModel == 'gemini-4-carbon' || data.preferredModel == 'gemini-3.8-flash') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: BotanicalNote (/botanicalNotes/{noteId})
    function isValidBotanicalNote(data) {
      return data.keys().hasAll(['userId', 'plantName', 'noteText', 'category', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'plantName', 'noteText', 'category', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.plantName is string && data.plantName.size() >= 1 && data.plantName.size() <= 100 &&
        data.noteText is string && data.noteText.size() >= 1 && data.noteText.size() <= 1000 &&
        data.category is string && data.category.size() <= 40 &&
        (data.category == 'Observation' || data.category == 'Search Grounding' || data.category == 'Live Voice Summary' || data.category == 'Care Log') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: VirtualGardenLayout (/gardenLayouts/{layoutId})
    function isValidVirtualGardenLayout(data) {
      return data.keys().hasAll(['userId', 'title', 'lightingPreset', 'specimenCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'title', 'lightingPreset', 'specimenCount', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.lightingPreset is string && data.lightingPreset.size() <= 24 &&
        (data.lightingPreset == 'golden' || data.lightingPreset == 'daylight' || data.lightingPreset == 'bioluminescent') &&
        data.specimenCount is int && data.specimenCount >= 1 && data.specimenCount <= 50 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: ImageCorrectionAudit (/imageCorrectionAudits/{auditId})
    function isValidImageCorrectionAudit(data) {
      return data.keys().hasAll(['userId', 'plantId', 'scientificName', 'actionType', 'source', 'license', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'plantId', 'scientificName', 'actionType', 'source', 'license', 'notes', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.plantId is string && data.plantId.size() >= 1 && data.plantId.size() <= 128 &&
        data.plantId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.scientificName is string && data.scientificName.size() >= 1 && data.scientificName.size() <= 140 &&
        data.actionType is string && data.actionType.size() <= 24 &&
        (data.actionType == 'flagged' || data.actionType == 'verified_override' || data.actionType == 'reverted') &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 120 &&
        data.license is string && data.license.size() >= 1 && data.license.size() <= 80 &&
        data.notes is string && data.notes.size() >= 1 && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Admins Registry (Read-only for verification; no client writes)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Connection Health Probe Document (/test/connection)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserPreference(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserPreference(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (request.auth.uid == userId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'theme', 'preferredLanguage', 'preferredModel', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // Collection 2: /botanicalNotes/{noteId}
    match /botanicalNotes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(noteId) &&
        isValidBotanicalNote(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser() &&
        isValidId(noteId) &&
        isValidBotanicalNote(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['plantName', 'noteText', 'category', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(noteId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Collection 3: /gardenLayouts/{layoutId}
    match /gardenLayouts/{layoutId} {
      allow get: if isSignedIn() && isValidId(layoutId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(layoutId) &&
        isValidVirtualGardenLayout(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser() &&
        isValidId(layoutId) &&
        isValidVirtualGardenLayout(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lightingPreset', 'specimenCount', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(layoutId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Collection 4: /imageCorrectionAudits/{auditId}
    match /imageCorrectionAudits/{auditId} {
      allow get: if isSignedIn() && isValidId(auditId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(auditId) &&
        isValidImageCorrectionAudit(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser() &&
        isValidId(auditId) &&
        isValidImageCorrectionAudit(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().plantId == existing().plantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['actionType', 'source', 'license', 'notes', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(auditId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
